{
  "name": "monorepo-starter",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.5.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.9.2",
  "license": "MIT",
  "author": "Sven Stam",
  "keywords": [
    "nestjs",
    "monorepo",
    "turborepo",
    "graphql",
    "jwt"
  ]
}
